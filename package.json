{
  "name": "dsh-github-inventory",
  "version": "0.6.6",
  "type": "module",
  "scripts": {
    "test": "node tests/run.mjs"
  },
  "description": "本地扩展清单：看看这台机器上从 GitHub 装了什么——每个东西能干什么、装在哪、有没有新版本，技能可随时开关。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loftspire/dsh-github-inventory.git"
  },
  "homepage": "https://github.com/loftspire/dsh-github-inventory#readme",
  "bugs": {
    "url": "https://github.com/loftspire/dsh-github-inventory/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skills",
    "inventory"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "catalog.json",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "tests",
    "RELEASE_NOTES.md",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
